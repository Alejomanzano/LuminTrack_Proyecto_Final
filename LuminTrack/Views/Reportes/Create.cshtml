@model LuminTrack.Models.Reporte

@{
    ViewBag.Title = "Crear Reporte";
}

<h2>Crear Reporte</h2>

@using (Html.BeginForm("Create", "Reportes", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Descripcion)
        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Categoría</label>
        @Html.DropDownListFor(m => m.Categoria,
            new SelectList(new[]
            {
                "Apagón",
                "Intermitente",
                "Poste caído",
                "Luminaria dañada",
                "Cable expuesto",
                "Otro"
            }),
            "-- Seleccione categoría --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Explique el problema (si eligió "Otro")</label>
        @Html.TextAreaFor(m => m.OtraCategoria, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Parroquia (Quito)</label>
        @Html.DropDownListFor(m => m.Parroquia,
            new SelectList(new[]
            {
                "Centro Histórico","La Mariscal","Iñaquito","Chillogallo","Carcelén",
                "Cotocollao","Calderón","Guamaní","La Ecuatoriana","Quitumbe",
                "San Bartolo","La Magdalena","San Roque","Pomasqui","Tumbaco",
                "Cumbayá","Pifo","Puembo","Tababela","Conocoto"
            }),
            "-- Seleccione parroquia --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Código Postal</label>
        @Html.TextBoxFor(m => m.CodigoPostal, new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Foto (opcional)</label>
        <input type="file" name="foto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Reporte</button>
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
}
