@model LuminTrack.Models.Reporte

@{
    ViewBag.Title = "Editar Reporte";
}

<h2>Editar Reporte</h2>

@using (Html.BeginForm("Edit", "Reportes", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Parroquia)
    @Html.HiddenFor(m => m.CodigoPostal)
    @Html.HiddenFor(m => m.UsuarioEmail)
    @Html.HiddenFor(m => m.FechaCreacion)
    @Html.HiddenFor(m => m.Estado)
    @Html.HiddenFor(m => m.PrioridadIA)

    <div class="form-group">
        @Html.LabelFor(m => m.Descripcion)
        @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Categoria)
        @Html.DropDownListFor(m => m.Categoria,
            new SelectList(new[] { "Apagón", "Intermitente", "Poste caído" }, Model.Categoria),
            "-- Seleccione categoría --",
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Foto Actual</label><br />
        @if (!string.IsNullOrEmpty(Model.FotoURL))
        {
            <img src="@Url.Content(Model.FotoURL)" width="120" />
        }
        else
        {
            <span>No hay foto</span>
        }
    </div>

    <div class="form-group">
        <label>Nueva Foto (opcional)</label>
        <input type="file" name="foto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-secondary" })
}
